# ============================================================================
# Docker / Railway Build Ignores
# Prevents unnecessary files from being sent to the build context
# ============================================================================

.git
.github
.gitignore
.cache
.local
.vscode
.idea

node_modules
dist
tmp
out-tsc
*.tsbuildinfo

.expo
.expo-shared

.cursor
.github

artifacts/sticker-bot-dashboard
artifacts/mockup-sandbox

lib/api-client-react
lib/api-spec
lib/api-zod

scripts

# WhatsApp session credentials — sensitive, never ship in image
artifacts/api-server/sessions/

# Local SQLite databases — not shipped; Railway uses persistent volumes
artifacts/api-server/data/*.db

# OS files
.DS_Store
Thumbs.db
