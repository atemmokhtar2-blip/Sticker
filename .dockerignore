# ============================================================================
# Docker build context ignores
# ============================================================================

# Git
.git
.github
.gitignore

# IDE / Editor
.vscode
.idea
.cache
.local

# Platform-specific configs (Railway uses its own config)
railway.json
railpack.json
render.yaml
replit.nix
.replit

# Documentation (not needed in Docker image)
README.md

# OS files
.DS_Store
Thumbs.db

# Build artifacts (will be built inside Docker)
node_modules
dist
tmp
out-tsc
*.tsbuildinfo
