{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "buildAptPackages": [
    "build-essential",
    "python3",
    "libsqlite3-dev"
  ],
  "steps": {
    "install": {
      "commands": [
        {
          "cmd": "corepack enable && pnpm install --frozen-lockfile",
          "customName": "Install dependencies with pnpm"
        },
        {
          "path": "/app/node_modules/.bin"
        }
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        {
          "cmd": "pnpm --filter @workspace/api-server run build",
          "customName": "Build api-server with esbuild"
        }
      ]
    }
  },
  "deploy": {
    "startCommand": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "variables": {
      "PHONE_NUMBER": "201044568121"
    }
  }
}
